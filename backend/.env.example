# Flask
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET_KEY=change-me-to-a-different-long-random-string
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# MongoDB
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=marketplace
# Credentials used by docker-compose (mongo service + app connection string)
MONGO_USER=marketplace
MONGO_PASSWORD=change-me-to-a-strong-password

# Initial admin seed (used by scripts/seed_admin.py only)
ADMIN_USERNAME=husnain
ADMIN_PASSWORD=change-me
ADMIN_EMAIL=admin@marketplace.local

# App
MARKETPLACE_NAME=NovaMarket
CURRENCY=PKR
CURRENCY_SYMBOL=Rs.
DEFAULT_COMMISSION_RATE=10
DELIVERY_FEE_STANDARD=20
DELIVERY_FEE_EXPRESS=50
FREE_DELIVERY_THRESHOLD=0
MAX_CONTENT_LENGTH_MB=5
REQUIRE_SELLER_APPROVAL=true
REQUIRE_PRODUCT_APPROVAL=false
# Set true to block login until the user verifies their email (requires SMTP)
REQUIRE_EMAIL_VERIFICATION=false

# Outbound email (password reset, email verification).
# Leave SMTP_HOST empty in development — messages are logged instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Public base URL used in emailed links (reset password, verify email)
FRONTEND_BASE_URL=http://localhost:5000

# Payments — comma-separated methods shown at checkout.
# Each method only activates once its gateway credentials below are set
# and the adapter in app/payments/gateway.py is implemented.
PAYMENT_METHODS_ENABLED=cod
# Stripe (cards) — implemented via Stripe Checkout + webhook.
# Requires a Stripe account in a supported country (not Pakistan).
# Register webhook URL: https://<domain>/api/payments/webhook/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# JazzCash — TODO(payment): adapter not implemented yet
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
# EasyPaisa — TODO(payment): adapter not implemented yet
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
